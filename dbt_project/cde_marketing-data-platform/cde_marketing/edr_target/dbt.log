{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.6\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"47631134-6f5a-40b0-b006-d64d9207d6ce\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"47631134-6f5a-40b0-b006-d64d9207d6ce\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        select\n            unique_id,\n            null as depends_on_nodes,\n            null as materialization,\n            'seed' as type\n        from `cde_marketing_development`.`marketing_elementary`.`dbt_seeds`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            materialization,\n            'snapshot' as type\n        from `cde_marketing_development`.`marketing_elementary`.`dbt_snapshots`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            materialization,\n            'model' as type\n        from `cde_marketing_development`.`marketing_elementary`.`dbt_models`\n        \n            where package_name != 'elementary'\n        \n        union all\n        select\n            unique_id,\n            null as depends_on_nodes,\n            null as materialization,\n            'source' as type\n        from `cde_marketing_development`.`marketing_elementary`.`dbt_sources`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            null as materialization,\n            'exposure' as type\n        from `cde_marketing_development`.`marketing_elementary`.`dbt_exposures`\n    \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "47631134-6f5a-40b0-b006-d64d9207d6ce", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.6\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"47631134-6f5a-40b0-b006-d64d9207d6ce\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"47631134-6f5a-40b0-b006-d64d9207d6ce\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        select\n            unique_id,\n            null as depends_on_nodes,\n            null as materialization,\n            'seed' as type\n        from `cde_marketing_development`.`marketing_elementary`.`dbt_seeds`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            materialization,\n            'snapshot' as type\n        from `cde_marketing_development`.`marketing_elementary`.`dbt_snapshots`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            materialization,\n            'model' as type\n        from `cde_marketing_development`.`marketing_elementary`.`dbt_models`\n        \n            where package_name != 'elementary'\n        \n        union all\n        select\n            unique_id,\n            null as depends_on_nodes,\n            null as materialization,\n            'source' as type\n        from `cde_marketing_development`.`marketing_elementary`.`dbt_sources`\n        union all\n        select\n            unique_id,\n            depends_on_nodes,\n            null as materialization,\n            'exposure' as type\n        from `cde_marketing_development`.`marketing_elementary`.`dbt_exposures`\n    \n\n  ", "name": "SQLQuery", "pid": 52170, "thread": "MainThread", "ts": "2026-10-14T16:03:49.431725Z"}}
