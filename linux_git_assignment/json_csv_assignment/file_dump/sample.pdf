    <style>
.dcFullPageDiv {
    bottom: 0;
    height: 100vh;
    left: 0;
    position: fixed;
    right: 0;
    top: 0;
    width: 100vw;
    z-index: 9999;
}

.globalNavDiv {
    align-items: center;
    background-color: var(--dc-global-color-background);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-sizing: border-box;
    display: flex;
    justify-content: space-between;
    min-height: 64px;
    padding: 0 8px;
}

.mobileBannerDiv {
    background-color: var(--dc-global-color-background);
    min-height: 60px;
}  

.navigationContainerDiv,
.rightContainerDiv {
    align-items: center;
    display: flex;
}

.homeButtonDiv {
    cursor: pointer;
}

.globalNavMainContainerDiv {
    left: 50%;
    position: absolute;
    transform: translateX(-50%);
}

.rightContainerDiv {
    margin-right: 8px;
}

.brandLogo {
    height: 24px;
    margin-left: 16px;
    margin-right: 4px;
    width: 24px;
}

.verticalRule {
    --rule-background-color: var(--spectrum-global-color-gray-300);
    background-color: var(--rule-background-color);
    height: 24px;
    margin: 4px 8px;
    width: 1px;
}

.dcContainerDiv {
    display: flex;
    position: relative;
}

.dcQtDiv {
    box-shadow: 0 3px 6px hsla(0, 0%, 60%, 0.2);
    left: 16px;
    position: absolute;
    top: 16px;
}

.dcSidenavDiv {
    background: var(--dc-global-color-background);
    display: flex;
}

.dcSidenavExpandedPanelDiv {
    display: flex;
    height: 100%;
    width: var(--side-nav-width, 400px);
}

.dcSidenavExpandedPanelHandleDiv {
    height: 100%;
    width: 7px;
    z-index: 1;
}

.dcSidenavSkinnyRailDiv {
    align-items: center;
    border-left: 1px solid var(--spectrum-global-color-gray-200);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 51px;
}

.dcRenditionContainerDiv {
    height: calc(100vh - 63px);
    overflow: auto;
    width: 100%;
}

.spectrum--light .dcRenditionContainerDiv {
    background-color: var(--spectrum-global-color-gray-100);
}

.spectrum--dark .dcRenditionContainerDiv {
    background-color: var(--spectrum-global-color-gray-50);
}

.dcRenditionImageDiv {
    text-align: center;
    width: 100%;
}

.renditionImg {
    display: block;
    margin: 0 auto 15px;
    max-width: 100%;
}

.skeletonRectangle,
.skeletonCircle {
    --skeletonLoader-bgColor: var(--spectrum-global-color-gray-200);
    background-color: var(--skeletonLoader-bgColor);
    border-radius: 5px;
    display: block;
    height: 32px;
    overflow: hidden;
    position: relative;
    width: 32px;
}

.skeletonRectangle::before,
.skeletonCircle::before {
    --skeletonLoader-bgImg-color1: transparent;
    --skeletonLoader-bgImg-color2: rgba(255, 255, 255, 0.6);
    animation: progress 1.2s ease-in-out infinite;
    background-image: linear-gradient(
        90deg,
        var(--skeletonLoader-bgImg-color1),
        var(--skeletonLoader-bgImg-color2),
        var(--skeletonLoader-bgImg-color1)
    );
    content: "";
    height: inherit;
    position: absolute;
    width: inherit;
}

.spectrum--dark .skeletonRectangle::before,
.spectrum--dark .skeletonCircle::before {
    --skeletonLoader-bgImg-color2: var(--spectrum-global-color-gray-50);
}

@keyframes progress {
    0% {
        left: -100%;
    }

    100% {
        left: 100%;
    }
}

.skeletonCircle {
    border-radius: 50%;
    height: 32px;
    width: 32px;
}

.commentPanel {
  padding: 0 16px 40px 16px;
  top: 0;
  width: 100%;
}

.commentHeader {
  display: flex;
  margin: 16px 0;
}

.commentsFlexStyle {
  display: flex;
  flex-wrap: wrap;
}

@media (--forced-colors-active) {
    .skeletonRectangle,
    .skeletonCircle {
        --skeletonLoader-bgColor: CanvasText;
      /* stylelint-disable-next-line property-no-unknown */
        forced-color-adjust: none;
    }

    .spectrum .skeletonRectangle::before,
    .spectrum .skeletonCircle::before {
        --skeletonLoader-bgImg-color1: Canvas;
        --skeletonLoader-bgImg-color2: CanvasText;
    }
}</style>
    <script>(function removeEWLpmForNewIpadDevice() {
    document.addEventListener('DOMContentLoaded', () => {
    if (/iphone/i.test(window.navigator.userAgent) || /ipad/i.test(window.navigator.userAgent)) return;
    const isNewIpad = (("ontouchstart"in window || !!(window.navigator && (window.navigator.msMaxTouchPoints || window.navigator.maxTouchPoints))) && /Mac OS/.test(window.navigator.userAgent));
    if (isNewIpad) {
        const dcLpmEle = document.getElementById("dcLPM");
        dcLpmEle.remove();
        window.adobe_dc_data.data.file.lpm.shouldRenderLpmThroughEW = false;
    }
});
}());
function loadRenditionImage(index) {
    const assetURLs = window.adobe_dc_data.data.file.assetURLs;
    const renditionImageDiv = document.getElementById('renditionImage');
    const firstImgEle = renditionImageDiv.children[0];
    if (firstImgEle) {
        const imgElement = document.createElement('img');
        imgElement.alt = "Rendition " + index;
        imgElement.crossOrigin = "anonymous";
        imgElement.id = 'renditionImage' + index;
        imgElement.style.cssText = firstImgEle.style.cssText;
        imgElement.src = assetURLs.url.replace(/page=\d+/g, 'page=' + index);
        imgElement.onload = function() {
            handleImageLoad(index);
        };
        imgElement.onerror = function(event) {
            handleImageError(event, index);
        };
        renditionImageDiv.appendChild(imgElement);
    }
};
function handleLPMScroll(event) {
    const renditionImages = window.adobe_dc_data.data.file.lpm.renditionImages;
    const totalPageCount = 12;
    const renditionContainerDiv = document.querySelector(".dcRenditionContainerDiv");
    const { scrollTop, scrollHeight, clientHeight } = renditionContainerDiv;
    const margin = 300;
    const isNearBottom = (scrollTop + clientHeight + margin) >= scrollHeight;
    if (isNearBottom && renditionImages[renditionImages.length - 1].rendered) {
        const remainingPagesToRender = totalPageCount - renditionImages.length;
        const nextPageIndex = renditionImages.length;
        if (remainingPagesToRender >= 2) {
            renditionImages.push({ rendered: false });
            renditionImages.push({ rendered: false });
        } else if (remainingPagesToRender === 1) {
            renditionImages.push({ rendered: false });
        }
        if(remainingPagesToRender > 0) {
            window.adobe_dc_data.data.file.lpm.renditionImages = renditionImages;
            loadRenditionImage(nextPageIndex);
        }
    }
};
function handleImageLoad(index) {
    const renditionImages = window.adobe_dc_data.data.file.lpm.renditionImages;
    window.adobe_dc_data.data.file.lpm.renditionImages[index].rendered = true;
    const evt = new CustomEvent("ewLpmImageLoaded", {detail: {pageNum: index}});
    window.dispatchEvent(evt);
    if(false) {
        if (window.performance && window.performance.mark) {
            window.performance.mark('web_app_lpm-loaded');
        }
    } else {
        if (window.performance && window.performance.mark) {
            window.performance.mark('web_app_multi-lpm-loaded-page' + index);
        }
        if(index+1<renditionImages.length && renditionImages[index + 1].rendered === false) {
            loadRenditionImage(index + 1);
        }
    }
};
function handleImageError(e, index) {
    if (e.target) {
        e.target.style.display = "none";
    }
    if (index === 0) {
        window.performance.mark('web_app_multi-lpm-error-page-' + index);
    }
};
(function attachHomeListener() {
    document.addEventListener('DOMContentLoaded', () => {
        let homeButton = document.getElementsByClassName("homeButtonDiv");
        if (homeButton && homeButton.length) {
            homeButton = homeButton[0];
            homeButton.addEventListener('click', function() {
                const homeLink = '/link/home';
                const removeParams = ["defaultRHPFeature", "isLocalAsset", "transientAssetDeleted", "conversationId"];
                const currentUrl = new URL(window.location.href);
                const searchParams = new URLSearchParams(currentUrl.search);
                removeParams.forEach(param => {
                    searchParams.delete(param);
                });
                const searchParamsString = searchParams.toString();
                const updatedUrl = homeLink + '?' + searchParamsString;
                window.location.pathname = updatedUrl;
            });
        }
    })
}());
(function computeLocalStorageSkinnyRail() {
    const sideNavWidth = Number(window.sessionStorage.getItem("sid-nav-width")) || 400;
    const sideNavWidthStr = sideNavWidth + "px";
    document.documentElement.style.setProperty('--side-nav-width', sideNavWidthStr);
}());
(function attachEventListenersForMultiLpm() {
    document.addEventListener('DOMContentLoaded', () => {
        if(true) {
            let dcRenditionContainerDiv = document.getElementsByClassName("dcRenditionContainerDiv");
            if (dcRenditionContainerDiv && dcRenditionContainerDiv.length) {
                dcRenditionContainerDiv = dcRenditionContainerDiv[0];
                dcRenditionContainerDiv.addEventListener('scroll', function(event) {
                    handleLPMScroll(event);
                });
            }
        }
        let renditionImage0 = document.getElementById("renditionImage0");
        if (renditionImage0) {
            if (renditionImage0.complete) {
                if (renditionImage0.naturalWidth > 0) {
                    handleImageLoad(0);
                } else {
                    handleImageError({target: renditionImage0}, 0);
                }
            } else {
                renditionImage0.addEventListener('load', function(event) {
                    handleImageLoad(0);
                });
                renditionImage0.addEventListener('error', function(event) {
                    handleImageError(event, 0);
                });
            }
        }
    });
}());</script>
