                transform: translate(192px);
            }
        }
        html, body {
            margin: 0;
            padding: 0;
        }
        .acrobat-loading {
            display: none;
            height: 100vh;
            position: absolute;
            width: 100vw;
            z-index: 1;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
        .acrobat-loading-container {
            background-color: transparent;
            border-radius: 10px;
            padding: 48px;
        }
