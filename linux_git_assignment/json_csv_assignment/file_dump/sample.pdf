cleLoader-fills"><div class="spectrum-CircleLoader-fillMask1"><div class="spectrum-CircleLoader-fillSubMask1"><div class="spectrum-CircleLoader-fill"></div></div></div><div class="spectrum-CircleLoader-fillMask2"><div class="spectrum-CircleLoader-fillSubMask2"><div class="spectrum-CircleLoader-fill"></div></div></div></div></div></div><div id="root" style="height: 100%; isolation: isolate;"></div><div class="one-trust-notice" style="display:none"></div><script id="dc_inlined_js">
(function initOverrides() {
  window.dcAppOverrides = {"dc-web-app":{}};
}());


(function initAppData() {
  const dcDataTag = document.querySelector('#dc_data');
  if (dcDataTag) {
    const dcData = dcDataTag.textContent;
    try {
      window.adobe_dc_data = JSON.parse(dcData);
    } catch (e) {}
  }
}());



  (function initDownloadPdfAndRendition() {
          performance.mark("web_app_inline-script-start");
          function storePDFFetchPromise() {
              const downloadUrl = window.adobe_dc_data.data.file.assetURLs.download_url;
              window.adobe_dc_data.data.file.pdfFetchPromise = fetch(downloadUrl)
                  .then(response => {
                      if (!response.ok) {
                          throw new Error("Failed to fetch file: "+ response.status);
                      }
                      return response.arrayBuffer().then(buffer => {
                          if (window.performance && window.performance.mark) {
                            window.performance.mark('web_app_pdfDownloadEndTimeInlineScript');
                          }
                          return {
                              buffer: buffer,
                              mimeType: response.headers.get("content-type"),
                              xRequestId: response.headers.get("x-request-id"),
                              xCache: response.headers.get("x-cache"),
                              };
                      });
                  });
          }
          // NOTE: This function is not used in the current implementation
          function storePDFRenditionFetchPromise() {
              const renditionUrl = window.adobe_dc_data.data.file.assetURLs.url;
              window.adobe_dc_data.data.file.pdfRenditionFetchPromise = fetch(renditionUrl)
                  .then(response => {
                      if (!response.ok) {
                          throw new Error("Failed to fetch file Rendition: "+response.status);
                      }
                      return response.arrayBuffer().then(buffer => {
                          return {
                              buffer: buffer,
                              mimeType: response.headers.get("content-type"),
                              xRequestId: response.headers.get("x-request-id"),
                              xCache: response.headers.get("x-cache"),
                              };
                      });
                  });
          }

          if(window?.adobe_dc_data?.data?.file?.assetURLs?.download_url) {
            storePDFFetchPromise();
          }
          }());
(function initBootstrapData() {
          let checkStatus = (response) => {
              // Check the status, respond
              if (response.status >= 200 && response.status < 300) {
                  return response;
              } else {
                  let error = new Error(response.statusText);
                  error.response = response;
                  throw error;
              }
          };
          let parseJSON = (response) => {
              if (window.performance && window.performance.mark) {
                window.performance.mark('web_app_bootstrapCallEndInlineScript');
              }
              return response.json();
          };
          let detectBrowserProps = () => {
              let browserProps = {
                'browserProps': {
                  'screen.width': window.screen.width,
                  'screen.height': window.screen.height,
                  'screen.availHeight': window.screen.availHeight,
                  'screen.availWidth': window.screen.availWidth,
                  'screen.pixelDepth': window.screen.pixelDepth,
                  'screen.colorDepth': window.screen.colorDepth,
                  'navigator.userAgent': window.navigator.userAgent,
                  'robotClientLikely': false
                }
              };
              if (screen.width === 1280
                && screen.height === 960
                && screen.availWidth === 1280
                && screen.availHeight === 960
              ) {
                browserProps.browserProps.robotClientLikely = true;
              }
              return browserProps;
            };
            // Correctly assign browserProps within the string literal
            let updatedHeaders = {"x-visitor-id":"first_time_user","Content-Type":"application/json"};
            
            const constructBootstrapApiUrl = () => {
              const splittedPathnames = window.location.pathname.split("/");
              const assetId =
                splittedPathnames[
                  splittedPathnames.length > 2 ? 2 : splittedPathnames.length - 1
                ];
              if(window?.adobe_dc_data?.data?.file?.shouldFetchBootstrapDataFromEW) {
                return "/link/api/sendBootstrapData?id=" + decodeURIComponent(assetId);
              } else {
                return "https://send-asr.acrobat.com/a/preview/" + decodeURIComponent(assetId) + "/bootstrap?shareinfo=true";
              }
            }
            const bootstrapApiUrl = constructBootstrapApiUrl();
            updatedHeaders["x-api-client-info"] = JSON.stringify(detectBrowserProps().browserProps);
                            window.adobe_dc_data.data.file.bootstrapDataPromise = fetch(bootstrapApiUrl,
                            {
                                method: 'GET',
                                headers: updatedHeaders,
                            }
                        ).then(checkStatus).then(parseJSON).catch((error) =>
                            Promise.reject(error.response ? error.response : error));
                        }());

  (function wasmPreloadScript() {

    // Getting wasm file name from index.html
    const metaDescription = document.querySelector('meta[name="wasm_manifest_prod"]');
    const wasmManifest = JSON.parse(metaDescription.content);
    const wasmFileName = wasmManifest["wasm_manifest"]["wasm_acrobat_we.wasm"];
    
    //  Creating wasm link
    const wasmLink = document.createElement('link');
    wasmLink.href = '/dc-rendition-provider/AJS/build/' + wasmFileName;
    wasmLink.rel = 'preload';
    wasmLink.as = 'fetch';
    wasmLink.type = 'application/wasm';
    
    // Append the link element to the head of the document
    document.head.appendChild(wasmLink);
  }());
  

  (function wasmJSPreloadScript() {

    // Getting wasm file name from index.html
    const metaDescription = document.querySelector('meta[name="wasm_manifest_prod"]');
    const wasmManifest = JSON.parse(metaDescription.content);
    const wasmJsFileName = wasmManifest["wasm_manifest"]["wasm_acrobat_we.js"];

    // Creating wasmJS Link
    const wasmJSLink = document.createElement('link');
    wasmJSLink.href = '/dc-rendition-provider/AJS/build/' + wasmJsFileName;
    wasmJSLink.rel = 'preload';
    wasmJSLink.as = 'script';
    
    // Append the link element to the head of the document
