--iconGreen: var(--spectrum-global-color-green-500);\n  --iconRed: var(--spectrum-global-color-red-500);\n  --iconOrange: var(--spectrum-global-color-orange-500);\n  --iconPurple: var(--spectrum-global-color-purple-500);\n  --iconIndigo: var(--spectrum-global-color-indigo-500);\n  --iconCelery: var(--spectrum-global-color-celery-500);\n  --iconMagenta: var(--spectrum-global-color-magenta-500);\n  --iconYellow: var(--spectrum-global-color-yellow-500);\n  --iconFuchsia: var(--spectrum-global-color-fuchsia-500);\n  --iconSeafoam: var(--spectrum-global-color-seafoam-500);\n  --iconChartreuse: var(--spectrum-global-color-chartreuse-500);\n}\n\n/**\n  dc-icons variables used by design team with custom light colors\n**/\n.spectrum--light {\n  --iconAcrobatScan: rgb(25, 179, 184);\n  --iconAcrobatRed: rgb(250, 15, 0);\n  --iconAcrobatBatchBg: rgb(44, 44, 44);\n  --illuStroke: rgb(177, 177, 177);\n  --illuCloudColor: rgb(202, 232, 255);\n  --illuAcrobatRedSecondary: rgb(250,15,0);\n  --illuAcrobatPurpleSecondary: rgb(105, 91, 164);\n  --illuAcrobatGray: rgb(75, 75,75);\n  --iconAcrobatRedSecondary: rgb(255, 221, 214);\n  --iconAcrobatRedAccent: rgb(180,0,0);\n  --iconBlueBackground: rgb(224, 242,255);\n  --iconGreenBackground: rgb(206, 248, 224);\n  --iconRedBackground: rgb(255,235, 231);\n  --iconOrangeBackground: rgb(255, 236, 204);\n  --iconYellowBackground: rgb(251, 241, 152);\n  --iconPurpleBackground: rgb(246,235, 255);\n  --iconIndigoBackground: rgb(237, 238, 255);\n  --iconCeleryBackground: rgb(205, 252, 191);\n  --iconMagentaBackground: rgb(255, 234, 241);\n  --iconFuchsiaBackground: rgb(255, 233, 252);\n  --iconSeafoamBackground: rgb(206, 247, 243);\n  --iconChartreuseBackground: rgb(219, 252, 110);\n  --iconIndigoGenAIBackground: rgb(82, 88, 228);\n  --iconIndigoGenAI: rgb(88, 76, 204);\n  --iconIndigoDark: rgb(38 41 134);\n}\n\n/**\n  dc-icons variables used by design team with custom dark colors\n**/\n.spectrum--dark {\n  --iconAcrobatScan: rgb(42, 187, 191);\n  --iconAcrobatRed: rgb(250, 15, 0);\n  --iconAcrobatBatchBg: rgb(90, 90, 90);\n  --illuStroke: rgb(176, 176, 176);\n  --illuCloudColor: rgb(83, 90, 97);\n  --illuAcrobatRedSecondary: rgb(234, 56, 41);\n  --illuAcrobatPurpleSecondary: rgb(127, 109, 199);\n  --illuAcrobatGray: rgb(177, 177, 177);\n  --iconAcrobatRedSecondary: rgb(165, 0, 0);\n  --iconAcrobatRedAccent: rgb(255, 201, 189);\n  --iconBlueBackground: rgb(0, 56, 119);\n  --iconGreenBackground: rgb(4, 67, 41);\n  --iconRedBackground: rgb(123, 0, 0);\n  --iconOrangeBackground: rgb(102, 37, 0);\n  --iconYellowBackground: rgb(76, 54, 0);\n  --iconPurpleBackground: rgb(76, 13, 157);\n  --iconIndigoBackground: rgb(40, 44, 140);\n  --iconCeleryBackground: rgb(0, 69, 10);\n  --iconMagentaBackground: rgb(118, 0, 58);\n  --iconFuchsiaBackground: rgb(107, 3, 106);\n  --iconSeafoamBackground: rgb(18, 65, 63);\n  --iconChartreuseBackground: rgb(48, 64, 0);\n  --iconIndigoGenAIBackground: rgb(162, 170, 255);\n  --iconIndigoGenAI: rgb(196, 199, 255);\n  --iconIndigoDark: rgb(226 228 255);\n}\n\n/**\n  dc-icons variable implemetation per user interaction state\n**/\n\n.spectrum button.is-selected {\n  --iconFill: var(--spectrum-global-color-gray-900);\n}\n\n.spectrum button.focus-ring {\n  --iconFill: var(--spectrum-global-color-gray-900);\n}\n\n.spectrum button:hover {\n  --iconFill: var(--spectrum-global-color-gray-900);\n}\n\n.spectrum button:disabled,\n.spectrum button.is-disabled {\n  --iconFill: var(--spectrum-global-color-gray-400);\n}\n",""]),n.exports=o},YWiy:(n,o,i)=>{n.exports=i("2pFd")("GiK3")},aTLM:(n,o,i)=>{(o=i("AXyZ")(!1)).push([n.id,'/*************************************************************************\n* ADOBE CONFIDENTIAL\n* ___________________\n*\n* Copyright 2019 Adobe\n* All Rights Reserved.\n*\n* NOTICE: All information contained herein is, and remains\n* the property of Adobe and its suppliers, if any. The intellectual\n* and technical concepts contained herein are proprietary to Adobe\n* and i