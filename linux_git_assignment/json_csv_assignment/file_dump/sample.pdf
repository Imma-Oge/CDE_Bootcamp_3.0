        .acrobat-loading-indicator {
            width: 208px;
            max-width: 50vw;
            padding: 32px 8px;
            box-sizing: border-box;
            margin: 0 auto;
        }
        .acrobat-loading-indicator-track {
            background-color: var(--spectrum-global-color-gray-200);
            border-radius: 3px;
            height: 6px;
            overflow: hidden;
        }
        .acrobat-loading-indicator-fill {
            background-color: var(--spectrum-global-color-blue-400);
            border-radius: 3px;
            height: 6px;
            width: 136px;
            animation: loading-animation 1s cubic-bezier(0.45, 0, 0.4, 1) infinite;
        }

